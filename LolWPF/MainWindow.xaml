<Window x:Class="LolWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LolWPF"
        mc:Ignorable="d"
        Title="LOL Hősök" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="1" x:Name="datagrid" />
        <Button Content="Keresés" HorizontalAlignment="Left" Margin="214,0,0,0" VerticalAlignment="Center"/>
        <Button Content="Mentés" HorizontalAlignment="Left" Margin="507,0,0,0" VerticalAlignment="Center"/>
        <ComboBox HorizontalAlignment="Left" Margin="354,0,0,0" VerticalAlignment="Center" Width="120"/>
        <TextBox HorizontalAlignment="Left" Margin="71,0,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Center" Width="120"/>
    
    </Grid>
</Window>
